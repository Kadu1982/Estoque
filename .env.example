# ── DATABASE ──────────────────────────────────────
POSTGRES_DB=austral_estoque
POSTGRES_USER=austral
POSTGRES_PASSWORD=change_me_strong_password

# ── REDIS ─────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change_me_super_secret_key_at_least_64_chars_long_for_hs512
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── AUTH MODE ─────────────────────────────────────
# Options: JWT | OAUTH2 | LDAP | ALL
AUTH_MODE=JWT

# OAuth2 / Keycloak (se AUTH_MODE=OAUTH2 ou ALL)
OAUTH2_ISSUER_URI=https://keycloak.austral.com/realms/austral
OAUTH2_CLIENT_ID=austral-api
OAUTH2_CLIENT_SECRET=

# LDAP (se AUTH_MODE=LDAP ou ALL)
LDAP_URL=ldap://ldap.austral.com:389
LDAP_BASE_DN=dc=austral,dc=com
LDAP_USER_DN_PATTERN=uid={0},ou=people

# ── E-MAIL ────────────────────────────────────────
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM=noreply@austral.com

# ── WHATSAPP (Z-API ou Twilio) ────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://api.z-api.io/instances/YOUR_INSTANCE/token/YOUR_TOKEN/send-text
WHATSAPP_TOKEN=

# ── SMS (Twilio) ──────────────────────────────────
SMS_ENABLED=false
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+1234567890

# ── ERP INTEGRATION ───────────────────────────────
ERP_ENABLED=false
ERP_URL=
ERP_TOKEN=

# ── APP ───────────────────────────────────────────
FRONTEND_URL=https://estoque.austral.com
APP_SEED_ADMIN_EMAIL=admin@austral.com
APP_SEED_ADMIN_PASSWORD=Admin@123456

# ── PGADMIN (dev only) ────────────────────────────
PGADMIN_EMAIL=admin@austral.com
PGADMIN_PASSWORD=admin123
